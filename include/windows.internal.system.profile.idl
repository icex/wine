/*
 * Windows.Internal.System.Profile.RegionPolicyEvaluator
 *
 * An undocumented, static-only runtime class that Store/Xbox titles consult to
 * ask whether a feature is permitted in the user's region. Its shape (one
 * statics interface, two methods, a three-state enum) is documented by the
 * regionpolicyevaluator-skeleton project. A title that cannot activate it
 * throws, so we answer every policy as Enabled.
 */

#ifdef __WIDL__
#pragma winrt ns_prefix
#endif

import "inspectable.idl";
import "windowscontracts.idl";

namespace Windows.Internal.System.Profile {
    typedef enum PolicyState PolicyState;
    interface IRegionPolicyEvaluatorStatics;
    runtimeclass RegionPolicyEvaluator;

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum PolicyState
    {
        Unknown  = 0,
        Enabled  = 1,
        Disabled = 2,
    };

    [
        contract(Windows.Foundation.UniversalApiContract, 1.0),
        exclusiveto(Windows.Internal.System.Profile.RegionPolicyEvaluator),
        uuid(1ca20398-c1d9-5f12-b40a-6528206e3b5e)
    ]
    interface IRegionPolicyEvaluatorStatics : IInspectable
    {
        HRESULT EvaluatePolicyState([in] GUID policy, [out, retval] Windows.Internal.System.Profile.PolicyState *result);
        HRESULT ForceEvaluatePolicyState([in] GUID policy, [out, retval] Windows.Internal.System.Profile.PolicyState *result);
    }

    [
        contract(Windows.Foundation.UniversalApiContract, 1.0),
        marshaling_behavior(agile),
        static(Windows.Internal.System.Profile.IRegionPolicyEvaluatorStatics, Windows.Foundation.UniversalApiContract, 1.0),
        threading(both)
    ]
    runtimeclass RegionPolicyEvaluator
    {
    }
}
