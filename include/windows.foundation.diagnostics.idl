    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum LoggingLevel
    {
        Verbose     = 0,
        Information = 1,
        Warning     = 2,
        Error       = 3,
        Critical    = 4,
    };

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
